# Copy this file to frontend/.env and fill in real values.
# frontend/.env is gitignored and must never be committed.

# IMPORTANT: only REACT_APP_* variables are readable by the app, and Create
# React App substitutes them into the JavaScript bundle AT BUILD TIME. Whatever
# you put here is shipped to every visitor's browser and can be read from the
# page source. Never put a server-side secret behind a REACT_APP_ name.

# --- Google Maps ------------------------------------------------------------
# Used by the map on the property detail page. A browser key cannot be hidden,
# so restrict it in the Google Cloud console instead:
#   - Application restriction: HTTP referrers, limited to your own domains
#     (add http://localhost:3000/* for development)
#   - API restriction: Maps Embed API only
# Leave it empty and the map area explains what is missing rather than
# rendering a broken embed.
REACT_APP_GOOGLE_MAPS_API_KEY=

# --- Development ------------------------------------------------------------
# Turns off the eslint-webpack-plugin that runs inside the dev server. Linting
# still runs on demand through `npm run lint`, which is the check that has to
# pass. Optional.
DISABLE_ESLINT_PLUGIN=true
