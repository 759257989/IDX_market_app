# Repo-wide safety net. The per-package .gitignore files (frontend/, backend/)
# still apply; these rules catch anything added outside them, at any depth.

/weeks

# --- Secrets -----------------------------------------------------------------
# Matches .env in every directory, not just the repo root. Keep this broad:
# a secret leaks the moment one lands in a folder nobody wrote a rule for.
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# --- Dependencies and build output -------------------------------------------
node_modules/
coverage/
build/
dist/

# --- Local database dumps ----------------------------------------------------
# The rets_*.sql dumps are hundreds of MB and hold listing data; they belong
# outside the repo. backend/sql/*.sql (schema and indexes) stays tracked.
rets_*.sql
*.sql.gz
*.dump

# --- Editor and OS noise -----------------------------------------------------
.DS_Store
.idea/
*.swp

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Local tooling scratch ---------------------------------------------------
.playwright-mcp/
