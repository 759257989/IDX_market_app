# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must never be committed.

# --- Database ---------------------------------------------------------------
# Host and port of the MySQL server. With the Docker command in the README the
# container publishes its 3306 on the host's 3307, so DB_PORT is 3307, not 3306.
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=rets

# --- Server -----------------------------------------------------------------
# 5001 rather than 5000: on macOS, port 5000 is taken by the AirPlay Receiver,
# which answers with a 403 and makes the frontend proxy look broken.
# This must match the "proxy" field in frontend/package.json.
PORT=5001
